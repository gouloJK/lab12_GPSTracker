<?xml version="1.0" encoding="utf-8"?>
<!--
    Path: app/src/main/res/layout/activity_location_map.xml
    Purpose: Full-screen map showing all tracked locations
    Uses OSMDroid for free OpenStreetMap display
-->

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- OpenStreetMap view - free alternative to Google Maps -->
    <org.osmdroid.views.MapView
        android:id="@+id/osmMapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />

    <!-- Top toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/mapToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primaryColor"
        android:elevation="8dp"
        app:title="Location History Map"
        app:titleTextColor="@color/textOnPrimary"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@color/textOnPrimary" />

    <!-- Refresh button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/refreshMapFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="24dp"
        android:src="@android:drawable/ic_popup_sync"
        android:contentDescription="Refresh Map Data"
        app:backgroundTint="@color/accentColor"
        app:tint="@color/textOnPrimary"
        app:elevation="8dp"
        app:fabSize="normal" />

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/mapLoadingIndicator"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminateTint="@color/primaryColor" />

    <!-- Info text overlay -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_margin="16dp"
        android:layout_marginTop="72dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#E6FFFFFF">

        <TextView
            android:id="@+id/mapInfoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:text="No locations loaded"
            android:textSize="12sp"
            android:textColor="@color/textPrimary" />
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>